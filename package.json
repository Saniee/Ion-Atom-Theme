{
  "name": "ion-atom-theme",
  "displayName": "Ion Atom Theme",
  "description": "Blue and red dark and light themes inspired by the ion atom, with a distinct color for every token type",
  "version": "0.4.8",
  "publisher": "Saniee",
  "repository": {
    "type": "git",
    "url": "https://github.com/Saniee/Ion-Atom-Theme.git"
  },
  "license": "GPL-3.0-only",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#101e2e",
    "theme": "dark"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "dark",
    "light",
    "blue",
    "cyan",
    "rust",
    "svelte",
    "typescript",
    "python",
    "csharp",
    "cpp"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "contributes": {
    "themes": [
      {
        "label": "Ion Atom",
        "uiTheme": "vs-dark",
        "path": "./ion-color-theme.json"
      },
      {
        "label": "Ion Atom Light",
        "uiTheme": "vs",
        "path": "./ion-light-color-theme.json"
      },
      {
        "label": "Ion Atom Fusion",
        "uiTheme": "vs-dark",
        "path": "./ion-fusion-color-theme.json"
      }
    ]
  },
  "scripts": {
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  }
}